{
  "name": "luno-note",
  "private": true,
  "version": "1.5.0",
  "description": "Luno Note - Modern and intuitive note-taking application",
  "main": "electron/main.js",
  "author": {
    "name": "phanuwatla",
    "url": "https://github.com/phanuwatla"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/phanuwatla/luno-note.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "helper:build": "node scripts/build-fix-language-helper.mjs",
    "electron:dev": "node scripts/build-fix-language-helper.mjs && concurrently \"vite\" \"wait-on http://localhost:8080 && electron .\"",
    "electron:build": "node scripts/build-fix-language-helper.mjs && npm run build && electron-builder"
  },
  "build": {
    "appId": "com.luno.note",
    "productName": "Luno Note",
    "copyright": "Copyright © 2026 phanuwatla",
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "phanuwatla",
      "repo": "luno-note",
      "releaseType": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/bin/**/*",
      "!electron/helper/**/*"
    ],
    "extraResources": [
      {
        "from": "electron/bin/LunoFixLang.exe",
        "to": "LunoFixLang.exe"
      }
    ],
    "win": {
      "icon": "electron/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "legalTrademarks": "Luno Note",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Luno Note",
      "multiLanguageInstaller": true,
      "installerLanguages": [
        "th_TH",
        "en_US"
      ],
      "installerIcon": "electron/icon.ico",
      "uninstallerIcon": "electron/icon.ico",
      "artifactName": "${name}-setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-context-menu": "^2.2.15",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@tabler/icons-react": "^3.46.0",
    "@tiptap/extension-code-block-lowlight": "^3.30.1",
    "@tiptap/extension-image": "^3.20.4",
    "@tiptap/extension-link": "^3.20.4",
    "@tiptap/extension-placeholder": "^3.20.4",
    "@tiptap/extension-table": "^3.20.4",
    "@tiptap/extension-table-cell": "^3.20.4",
    "@tiptap/extension-table-header": "^3.20.4",
    "@tiptap/extension-table-row": "^3.20.4",
    "@tiptap/extension-task-item": "^3.20.4",
    "@tiptap/extension-task-list": "^3.20.4",
    "@tiptap/react": "^3.20.4",
    "@tiptap/starter-kit": "^3.20.4",
    "@uiw/react-codemirror": "^4.25.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dictionary-en": "^4.0.0",
    "dompurify": "^3.4.15",
    "electron-updater": "^6.8.9",
    "framer-motion": "^12.38.0",
    "jszip": "^3.10.1",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.31.0",
    "marked": "^17.0.4",
    "nspell": "^2.1.5",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "turndown": "^7.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@tailwindcss/typography": "^0.5.16",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.16.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.5",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "jsdom": "^20.0.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.0",
    "wait-on": "^9.1.0"
  }
}
