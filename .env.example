# Google Drive OAuth 2.0 Client ID (Desktop or Web application)
# Obtain yours from Google Cloud Console (https://console.cloud.google.com/)
# Enable "Google Drive API" and add "http://localhost:8080" to Authorized redirect URIs.
VITE_GOOGLE_CLIENT_ID=
# Optional Client Secret (not required for desktop/mobile PKCE clients)
VITE_GOOGLE_CLIENT_SECRET=
